<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF7043" /> <!-- Button color when pressed -->
            <corners android:radius="16dp" />
            <padding android:left="16dp" android:top="10dp" android:right="16dp" android:bottom="10dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerColor="#FFA726"
                android:endColor="#FB8C00"
                android:startColor="#FFB74D"
                android:type="linear"/>
            <corners android:radius="16dp" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp"/>
            <shadowColor android:color="#80000000"/>
            <stroke android:width="2dp" android:color="#FF5722"/>
        </shape>
    </item>
</selector>
