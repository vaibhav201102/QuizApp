<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When the button is pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/red"/> <!-- Dark Green -->
            <corners android:radius="16dp" />
            <padding android:left="16dp" android:top="10dp" android:right="16dp" android:bottom="10dp"/>
            <stroke android:width="2dp" android:color="@color/red"/>
        </shape>
    </item>

    <!-- Default Correct Answer Style -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerColor="@color/red"
                android:endColor="@color/red"
                android:startColor="@color/red"
                android:type="linear"/>
            <corners android:radius="16dp"/>
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp"/>
            <stroke android:width="2dp" android:color="#388E3C"/>
        </shape>
    </item>
</selector>
